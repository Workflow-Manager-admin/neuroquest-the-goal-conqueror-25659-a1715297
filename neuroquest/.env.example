# Environment sample for NeuroQuest (copy to .env, fill your values)
# NEVER put real secrets into git.

#--- Firebase ---
VITE_FIREBASE_API_KEY="your_firebase_key"
VITE_FIREBASE_AUTH_DOMAIN="yourproject.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="yourproject-id"
VITE_FIREBASE_STORAGE_BUCKET="your-bucket.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="longnum"
VITE_FIREBASE_APP_ID="your-app-id"

#--- OpenAI ---
VITE_OPENAI_API_KEY="sk-..."      # Place your OpenAI secret key here
# Optional: custom endpoint
# VITE_OPENAI_API_BASE_URL="https://api.openai.com/v1/chat/completions"

{
  "task_description": "{'component_name': 'Main Container for NeuroQuest: The Goal Conqueror', 'description': "Primary container for NeuroQuest: The Goal Conqueror implementation: NeuroQuest is a gamified productivity RPG web app where users set a major life goal (e.g., 'Crack GATE CS 2025'), and the app breaks it into smart quests using AI, tracks focus, rewards XP, and features 'Boss Battles' as deadlines. The app blends fantasy and futuristic themes, is fully responsive, modular, and API-ready, using React, Vite, TailwindCSS, Firebase, OpenAI, Google Calendar, and Lottie for a fun, motivational experience.", 'framework': 'vite', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Firebase Auth",\n      "description": "User authentication via Google and Email/Password using Firebase. Secure login with dark overlay and glowing card UI.",\n      "isEnabled": true\n    },\n    {\n      "name": "AI Goal Breakdown",\n      "description": "OpenAI GPT API generates a smart roadmap from the user\'s main goal, breaking it into quests and tasks.",\n      "isEnabled": true\n    },\n    {\n      "name": "Avatar System",\n      "description": "Fantasy-style avatar picker and NFT-style cosmetic rewards. Users can equip items and see their avatar update.",\n      "isEnabled": true\n    },\n    {\n      "name": "XP/HP System",\n      "description": "Gamified XP and HP bars, with XP for progress and HP loss for missed deadlines. Streaks and level-ups tracked globally.",\n      "isEnabled": true\n    },\n    {\n      "name": "Quest Log",\n      "description": "AI-generated and manual tasks grouped as Main Questline, Weekly Side Quests, and Daily Microtasks. Tasks can be checked off, added, or reorganized.",\n      "isEnabled": true\n    },\n    {\n      "name": "Boss Battles",\n      "description": "Major deadlines or milestones trigger \'Boss Battles\' with countdowns, dramatic effects, and Lottie victory animations. Success/failure affects XP/HP.",\n      "isEnabled": true\n    },\n    {\n      "name": "Focus Engine",\n      "description": "Simulated focus tracking samples user activity every 5s, awarding XP for focus and breaking streaks for inactivity. Calm mode detection included.",\n      "isEnabled": true\n    },\n    {\n      "name": "Inventory & Rewards",\n      "description": "Soul Tokens and cosmetic rewards for achievements. Inventory page shows unlocks and allows equipping items.",\n      "isEnabled": true\n    },\n    {\n      "name": "Calendar Sync",\n      "description": "Google Calendar API integration to sync deadlines, show events, and convert events into Boss Battles. App deadlines sync back to calendar.",\n      "isEnabled": true\n    },\n    {\n      "name": "Settings",\n      "description": "Toggle dark/light mode, animations, change goal, start new quest, and logout. User preferences stored securely.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive RPG UI",\n      "description": "Fantasy + futuristic themed, fully responsive layout with modular components, neon-glow buttons, and animated transitions.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "Vite"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#7c3aed",\n    "secondary": "#0f172a",\n    "accent": "#4ade80"\n  },\n  "theme": "auto",\n  "layoutDescription": "The UI features a fantasy-futuristic RPG dashboard with XP/HP bars at the top, avatar and quick stats in a sidebar, and main content zones for Focus Forest, Deadline Dungeon, and Daily Hills. Floating quest orb and overlays for focus engine and boss battles. All pages are responsive, with modular components and animated transitions. Navigation via React Router. Dark mode by default, with neon-glow accents and Lottie animations for feedback."\n}'}",
